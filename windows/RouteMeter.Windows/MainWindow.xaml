<Window x:Class="RouteMeter.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RouteMeter" Width="520" Height="740" MinWidth="460" MinHeight="360" ShowInTaskbar="False" WindowStartupLocation="CenterScreen">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="24">
   <DockPanel Margin="0,0,0,20"><TextBlock Text="RouteMeter" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="Status" Text="Waiting for Core" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
   <TextBlock Text="Live · Download | Upload" FontSize="14" Foreground="DimGray" Margin="0,0,0,8"/>
   <TextBlock x:Name="LiveDirect" Text="Direct   — | —" FontSize="19" Margin="0,4"/>
   <TextBlock x:Name="LiveProxy" Text="Proxy    — | —" FontSize="19" Margin="0,4"/>
   <TextBlock x:Name="LiveTotal" Text="Total    — | —" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,18"/>
   <DockPanel><TextBlock Text="Cumulative usage" FontSize="15" FontWeight="SemiBold"/><Button Content="Reset view" Click="Reset_Click" HorizontalAlignment="Right"/></DockPanel>
   <TextBlock x:Name="Since" Foreground="DimGray" Margin="0,6"/>
   <DataGrid x:Name="UsageGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Margin="0,6,0,18" FontSize="13">
    <DataGrid.Columns><DataGridTextColumn Header="" Binding="{Binding Name}" Width="80"/><DataGridTextColumn Header="Download" Binding="{Binding Download}" Width="*"/><DataGridTextColumn Header="Upload" Binding="{Binding Upload}" Width="*"/><DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*"/></DataGrid.Columns>
   </DataGrid>
   <Separator/>
   <TextBlock Text="Proxy usage by App" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,8"/>
   <CheckBox x:Name="ShowRates" Content="Show live rates" Checked="Mode_Changed" Unchecked="Mode_Changed" Margin="0,0,0,8"/>
   <TextBox x:Name="Filter" TextChanged="Filter_Changed" ToolTip="Filter apps" Padding="6" Margin="0,0,0,8"/>
   <DataGrid x:Name="AppGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="300" Margin="0,0,0,10" FontSize="13">
    <DataGrid.Columns><DataGridTextColumn Header="App" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Download" Binding="{Binding Download}" Width="95"/><DataGridTextColumn Header="Upload" Binding="{Binding Upload}" Width="95"/><DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="90"/></DataGrid.Columns>
    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Path}"/></Style></DataGrid.RowStyle>
   </DataGrid>
   <TextBlock x:Name="Quality" TextWrapping="Wrap" Foreground="DarkGoldenrod" Margin="0,8"/>
   <TextBlock Text="Core-routed application payload. Total includes Unknown routing. Unresolved owners stay Unattributed. No App identity is guessed." TextWrapping="Wrap" Foreground="DimGray" Margin="0,8"/>
   <TextBlock Text="Counters survive closed connections and normal restarts. A force-stop or power loss can lose the latest 1-second checkpoint interval." TextWrapping="Wrap" Foreground="DimGray" Margin="0,8,0,16"/>
   <Separator/>
   <WrapPanel Margin="0,12,0,0"><Button Content="Connect Core…" Click="Connect_Click" Margin="0,0,10,0"/><Button Content="Setup guide" Click="Guide_Click" Margin="0,0,10,0"/><Button Content="Quit" Click="Quit_Click"/></WrapPanel>
  </StackPanel>
 </ScrollViewer>
</Window>
